# Copia este archivo como .env y completa los valores.

# --- Flask ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
FLASK_DEBUG=true
PORT=5000
# crea/actualiza las tablas al arrancar
AUTO_MIGRATE=true
# contraseña inicial del usuario superadmin (solo si aún no existe)
SUPERADMIN_PASSWORD=cambia-esta-clave

# --- PostgreSQL ---
DB_HOST=localhost
DB_NAME=stockflow
DB_USER=postgres
DB_PASS=tu_password
DB_PORT=5432

# --- Inventario ---
# stock bajo = entre 1 y este número
LOW_STOCK_LIMIT=4

# --- Correo (alertas de stock y recuperar contraseña) ---
ADMIN_EMAIL=admin@tu-negocio.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=contraseña_de_aplicacion

# --- Wompi ---
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx
# true con llaves de prueba, false con llaves de producción
WOMPI_SANDBOX=true
# URL pública de la app (Wompi devuelve al cliente aquí)
BASE_URL=http://localhost:5000
